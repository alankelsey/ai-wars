{
  "mcpServers": {
    "local-llm": {
      "command": "uv",
      "args": [
        "run",
        "--script",
        "tools/local-llm-mcp/server.py"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--executable-path",
        "/usr/bin/google-chrome",
        "--viewport-size",
        "1280,800"
      ]
    }
  }
}
